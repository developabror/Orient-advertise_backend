# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# --- IDE: IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- IDE: Eclipse / VS Code ---
.classpath
.project
.settings/
bin/
.vscode/

# --- Java / OS ---
*.class
*.log
