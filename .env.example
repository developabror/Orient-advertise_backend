# Copy this file to `.env` (auto-loaded by docker-compose) and adjust if any of the
# default host ports clash on your machine. Defaults are already in the 1xxxx range
# to dodge common dev-box conflicts; only override when even those collide.

# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379
# MINIO_HOST_PORT=19000
# MINIO_CONSOLE_HOST_PORT=19001
# APP_HOST_PORT=18080

# ─────────────────────────────────────────────────────────────────────────────────────
# REQUIRED SECRETS — `docker compose up` ABORTS with a message if any of these is unset.
# ─────────────────────────────────────────────────────────────────────────────────────
# These used to be committed defaults in docker-compose.yml (apppass / minioadmin / an empty
# Redis password). On a box whose ports were reachable from the internet, that is the entire
# breach: Redis holds the refresh-token families, so write access is token forgery; MinIO holds
# every uploaded ad; Postgres answered SSLRequest with N, so queries crossed the internet in
# cleartext. They now have NO defaults anywhere — generate real ones.
#
#   JWT_SECRET            openssl rand -base64 48
#   POSTGRES_PASSWORD     openssl rand -base64 32
#   REDIS_PASSWORD        openssl rand -base64 32
#   MINIO_ROOT_PASSWORD   openssl rand -base64 32
#
# Rotating these on an existing deployment is NOT just an .env edit — the Postgres password lives
# in the initialised data directory and MinIO's root credentials are baked into its volume. See
# DEPLOY-subzero.md for the ordered procedure.
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional — override the database name/user (defaults: appdb / appuser).
# POSTGRES_DB=appdb
# POSTGRES_USER=appuser

# ─────────────────────────────────────────────────────────────────────────────────────
# Published-port bind address. Loopback by default: every service is reachable from the
# host but refuses off-host handshakes. Set this ONLY if you deliberately want LAN/internet
# exposure — on a public host that means Postgres, Redis, the PLAINTEXT API, the SPA and MinIO
# all answering the internet, which is what this default exists to prevent.
# BIND_ADDR=0.0.0.0
# NOTE (AUTH-04): the API trusts X-Forwarded-For only from loopback/private-range peers (the reverse
# proxy). With BIND_ADDR=0.0.0.0, a LAN client on a private address counts as such a peer and can
# spoof its IP for rate limits again. Narrowing the trusted set needs SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES
# (a regex matching ONLY your compose network's gateway, the peer Caddy's traffic arrives from) set in
# the app service's `environment:` via a compose override, as a single-quoted YAML string — putting it
# in this .env file alone does NOT reach the container. Never set it to an empty value: that trusts no
# proxy and puts every client into the proxy's single rate-limit bucket.

# Days after upload that raw originals under `raw/` are deleted by MinIO (0 = never, and
# content-raw then grows without bound). Processed MP4s and posters are never expired, so
# playback is unaffected; the cost is that retranscoding a file older than this can no longer
# work, because its source object is gone.
# MINIO_RAW_EXPIRY_DAYS=30

# How fast a MinIO outage heals itself. While object storage is marked degraded the backend
# re-probes it this often and clears the flag on the first successful round trip — no restart.
# While storage is healthy the probe makes no MinIO calls at all, so lowering this costs nothing
# in steady state. ISO-8601 duration; write PT30S, not 30 (a bare number means milliseconds).
# APP_MINIO_RECHECK_INTERVAL=PT30S

# Seed data (fake TV devices + the dev logins admin/password, operator/password, …) — OFF by
# default. Turn it on only for local development; NEVER on a real deployment. With it off, the app
# REFUSES TO START while any account still uses the default password.
# APP_SEED_ENABLED=true

# First ADMIN for a deployment without seed data. Used only while no active ADMIN exists: creates
# the user, or re-activates/promotes an existing one and sets this password. Both or neither;
# password >= 12 chars. Remove both after your first login.
# APP_BOOTSTRAP_ADMIN_USERNAME=you@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=

# How long an admin's "Allow re-registration" (device page) stays open. A TV box whose serial is
# already registered gets 409 from /api/devices/register outside such a window. ISO-8601 duration.
# APP_DEVICE_REREGISTRATION_WINDOW=PT1H

# Telegram bot — disabled by default. To turn it on, uncomment and fill BOTH the
# token and the username. The token comes from BotFather and MUST stay out of git
# (.env is gitignored; only this `.env.example` is tracked).
# TELEGRAM_BOT_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# Email (Gmail SMTP) — disabled by default. To enable, create a Gmail App Password
# (Google account → 2-Step Verification → App passwords) and set:
# APP_MAIL_ENABLED=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password   # NOT your Google account password
# APP_MAIL_FROM=you@gmail.com
# APP_FRONTEND_BASE_URL=https://your-spa-origin

# Remote view/control (operator "Connect" to a TV-Box) — DISABLED by default; the feature
# ships dark. With APP_REMOTE_ENABLED=false, POST /api/devices/{id}/remote returns 503 and
# the heartbeat never emits desiredRemoteSession, so the device wire is unchanged.
#
# THE BACKEND CARRIES NO MEDIA. The device and the operator browser meet on a separate relay
# VPS (never `subzero`); this service only mints the rendezvous and hands each side a signed,
# role-scoped, single-use ticket.
#
# REMOTE_RELAY_SIGNING_SECRET is the shared HMAC secret with the relay: >=32 bytes, env-only,
# never logged. The app FAILS TO START if it is missing or short while enabled=true.
# Generate one with: openssl rand -base64 48
# APP_REMOTE_ENABLED=true
# APP_REMOTE_SESSION_TTL=PT30M
# APP_REMOTE_RELAY_AGENT_URL=wss://relay.your-domain.uz/agent
# APP_REMOTE_RELAY_VIEWER_URL=wss://relay.your-domain.uz/viewer
# REMOTE_RELAY_SIGNING_SECRET=

# ---------------------------------------------------------------------------------------------
# Video transcoding — sizing for THIS host. Everything here is optional; the defaults are safe on
# a small container and the pool plans its own width from the CPU and memory limits it can see.
# Change these only when you know the host has room, or when you want to pin a number.
#
# How the planner works (TranscodeCapacityPlanner): concurrency = min(cpus - 1, (container memory
# limit - max heap - reserve) / job-memory-mb), clamped to [1, max-concurrency]. It reads the real
# cgroup limit, so `docker run -m` / `mem_limit` is respected. A 1-vCPU / 700 MiB box resolves to 1;
# an 8-core / 16 GB box resolves to 7. ffmpeg is a CHILD of the JVM, so its peak RSS counts against
# the same limit — which is why two concurrent encodes on a 700 MiB box are an OOM kill, and why
# the OOM killer picks the JVM (bigger) over ffmpeg.
#
# APP_VIDEO_TRANSCODE_CONCURRENCY=0        # 0 = auto-plan; a positive value overrides outright
# APP_VIDEO_TRANSCODE_MAX_CONCURRENCY=8    # ceiling for the auto plan
# APP_VIDEO_TRANSCODE_JOB_MEMORY_MB=320    # budget per encode; raise it if you raise the preset
# APP_VIDEO_TRANSCODE_QUEUE_CAPACITY=200
#
# x264 preset — the single biggest lever on memory (measured on one 13 s 1080p25 input):
#   veryfast  ~218 MiB peak, 14.3 s   (default: safe on any host)
#   medium    ~438 MiB peak, 44.9 s   (better compression; needs the headroom)
# APP_VIDEO_PRESET=veryfast
# APP_VIDEO_MAX_HEIGHT=1080            # cap output height; 720 roughly halves the working set
# APP_VIDEO_TIMEOUT=PT15M              # hard ceiling per encode; keep sweeper lease-timeout above it
#
# JVM sizing. Overridable so the same image fits any container. No GC is pinned — ergonomics picks
# SerialGC on a tiny host and G1 on a big one, which is the point.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=45 -XX:MaxMetaspaceSize=192m
#
# Transcode safety net (re-drives files whose transcode never started/finished). Defaults are fine.
# APP_VIDEO_SWEEPER_INTERVAL=PT2M
# APP_VIDEO_SWEEPER_MAX_ATTEMPTS=3
# APP_VIDEO_SWEEPER_STALE_ALERT_AFTER=PT10M   # also drives the /api/health transcode-backlog check

# ---------------------------------------------------------------------------------------------
# Nightly retention cleanup (02:00 Asia/Karachi). Each table has its OWN window; the defaults are
# right for a single small box and only need changing to keep data longer, or to drain a backlog
# faster. ISO-8601 durations (P14D, P90D, PT15M).
#
# audit_log is the shortest on purpose: NOTHING reads it (no API, no UI), every row carries a full
# HTTP request AND response body, and device-agent traffic is no longer audited at all — so what is
# left is a short forensic tail of operator/admin writes.
# playback_log is proof-of-play (billing and the per-content reports). DO NOT shorten it to reclaim
# disk — and note the device-facing POST /api/devices/{id}/playback refuses reports older than this
# same value, so shortening it silently starts rejecting a returning box's queued reports.
# A bare number means DAYS for the three windows and MINUTES for the run budget (so `90` is 90
# days, not Boot's default 90 milliseconds). Each window must be at least 1 day and each count
# above 0 — a bad value stops the app at startup and names the property, instead of deleting the
# table on the next nightly run.
# APP_RETENTION_AUDIT=P14D
# APP_RETENTION_PLAYBACK=P90D
# APP_RETENTION_EVENT=P90D
# APP_RETENTION_BATCH_SIZE=1000
# APP_RETENTION_MAX_RUN_DURATION=PT15M      # budget for the WHOLE run; backlog waits for tomorrow
# APP_RETENTION_MAX_BATCHES_PER_RUN=5000    # safety stop per table; the budget is the real limit
# APP_RETENTION_GUARD_WINDOW=true           # false lets the job run outside 01:00-04:00 (non-prod)
