# Copy this file to `.env` (auto-loaded by docker-compose) and adjust if any of the
# default host ports clash on your machine. Defaults are already in the 1xxxx range
# to dodge common dev-box conflicts; only override when even those collide.

# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379
# MINIO_HOST_PORT=19000
# MINIO_CONSOLE_HOST_PORT=19001
# APP_HOST_PORT=18080

# REQUIRED — JWT signing secret (>=32 bytes). The prod profile has no fallback, so the
# app won't start without it. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Telegram bot — disabled by default. To turn it on, uncomment and fill BOTH the
# token and the username. The token comes from BotFather and MUST stay out of git
# (.env is gitignored; only this `.env.example` is tracked).
# TELEGRAM_BOT_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# Email (Gmail SMTP) — disabled by default. To enable, create a Gmail App Password
# (Google account → 2-Step Verification → App passwords) and set:
# APP_MAIL_ENABLED=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password   # NOT your Google account password
# APP_MAIL_FROM=you@gmail.com
# APP_FRONTEND_BASE_URL=https://your-spa-origin
